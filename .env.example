# ----------------------------------------------------
# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y rellena los valores
# ----------------------------------------------------

# --- Configuración de Flask ---
# Genera una clave segura para producción. Puedes usar: openssl rand -hex 32
SECRET_KEY="una-clave-secreta-de-desarrollo-muy-simple"
# Cambia a 'true' para activar el modo debug de Flask
FLASK_DEBUG="true"

# --- Configuración de la Base de Datos (SQL Server) ---
DB_SERVER="localhost"
DB_NAME="SISTEMACOM"
DB_DRIVER="ODBC Driver 17 for SQL Server"

# --- Autenticación de la Base de Datos ---
# Si usas autenticación de Windows (Trusted Connection), deja DB_USER y DB_PASSWORD vacíos.
# Si usas SQL Server Authentication, proporciona el usuario y la contraseña.
DB_USER=
DB_PASSWORD=